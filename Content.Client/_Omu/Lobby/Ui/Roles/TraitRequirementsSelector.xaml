         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Orientation="Horizontal">

    <Control>
        <Button Name="ToggleableButton" ToggleMode="true">
            <BoxContainer Orientation="Horizontal">
                <Label Name="GlobalPointsCount" Text="" StyleClasses="LabelHeading" Margin="0 0 0 0"/>
