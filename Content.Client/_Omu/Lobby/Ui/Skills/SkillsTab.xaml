<BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
              Orientation="Vertical"
              Margin="10"
              SeparationOverride="6">
    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
        <Label Text="{Loc 'skill-allocation-points'}" StyleClasses="LabelHeading" HorizontalExpand="True" />
        <PanelContainer Name="PointsBadge" StyleClasses="highlight" VerticalAlignment="Center">
            <Label Name="PointsLabel" Margin="10 0" Align="Center" />
        </PanelContainer>
    </BoxContainer>
    <controls:HighDivider />
    <GridContainer Name="Skills" Columns="3" HorizontalExpand="True" HSeparationOverride="8"
                   VSeparationOverride="6" Margin="0 4" />
    <Label Name="EmptyLabel" Text="{Loc 'skill-allocation-empty'}" StyleClasses="LabelWeak" Visible="False" />
</BoxContainer>
