<ui:AdminObjectiveItem
    xmlns="https://spacestation14.io"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Omu.Client.Administration.UI">
    <PanelContainer VerticalExpand="True" Margin="2 2">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#25252a" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" Margin="5">
            <TextureRect Name="Icon" Stretch="KeepAspect" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4 0" />
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" VerticalAlignment="Center">
                <RichTextLabel Name="ObjectiveName" />
                <RichTextLabel Name="ObjectiveDescription" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</ui:AdminObjectiveItem>
