<target:AdminTargetGroup
    xmlns="https://spacestation14.io"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:target="clr-namespace:Content.Omu.Client.Administration.UI.Components.Target"
    xmlns:components="clr-namespace:Content.Omu.Client.Administration.UI.Components">
    <BoxContainer VerticalExpand="true" HorizontalExpand="true">
        <BoxContainer Orientation="Vertical" HorizontalExpand="true">
            <components:AdminObjectivesTitle Name="Title" />
            <PanelContainer VerticalExpand="true">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#211c2a" BorderColor="#545456" BorderThickness="2" />
                </PanelContainer.PanelOverride>
                <BoxContainer Name="Targets" Orientation="Vertical" VerticalExpand="true" SeparationOverride="4" />
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</target:AdminTargetGroup>
