voodoo-base-message = [textshader="{$text}" font="DefaultBold" size={$size} shader="VoodooShader"]

voodoo-victim-bound = You feel a chill run down your spine.
voodoo-victim-unbound = You feel a sense of relief.

voodoo-victim-hint-direction = You sense a dark presence to the { $direction }.
voodoo-victim-hint-beacon = You sense a dark presence near { $beacon }.

voodoo-victim-heat = It suddenly feels hot!
voodoo-victim-heat-ignite = It burns!
voodoo-victim-cut = Something impossibly sharp slashes your body!
voodoo-victim-thrown = An overwhelming force sends you flying!
voodoo-victim-trip = You suddenly collapse!
voodoo-victim-fling = Your arm jerks violently!
voodoo-victim-hug = You feel something wrap you in a warm embrace.
voodoo-victim-soap = Everything feels impossibly slippery!
voodoo-victim-soap-end = You catch your footing again.
voodoo-victim-flash = A blinding light flares behind your eyes!
voodoo-victim-blindfold = Total darkness obscures your vision...
voodoo-victim-mute = You suddenly can't speak!
voodoo-victim-destroyed = Your body is being torn apart!

voodoo-user-bound = The doll twitches as it becomes bound to { THE($target) }.
voodoo-user-read = The doll stirs as it nears { THE($item) }.
voodoo-user-read-empty = There's no trace of anyone on { THE($item) }.
voodoo-user-unbind = Unbind
voodoo-user-unbound = The doll shudders as its binding breaks.
voodoo-user-not-bound = The doll is lifeless.
voodoo-user-hug = You give the doll a gentle squeeze.
voodoo-user-attack = You swing the doll's arm.
voodoo-user-fling = You yank the doll's hand.
voodoo-user-trip = You twist the doll's legs.
voodoo-user-shock = You shock the doll.
voodoo-user-flash = You flash the doll's eyes.
voodoo-user-blindfold = You hold the blindfold over the doll's eyes.
voodoo-user-soap = You lather the doll with soap.
voodoo-user-heat = You sear the doll with the flame.
voodoo-user-cut = You slash the doll.
voodoo-user-poke = You poke the doll's mouth.
voodoo-user-weh = You weh the doll.
voodoo-user-honk = You honk at the doll.
voodoo-user-yawn = You tuck the doll in with the bedsheet.
voodoo-user-cooldown = The doll is recovering its power.
voodoo-user-out-of-range = { THE($target) } is too far away.
voodoo-user-stowed = There's not enough room to use the doll in there.
voodoo-user-shielded = { CAPITALIZE(THE($target)) } seems to be shielded by something holy.
voodoo-user-doll-bound = This doll is already bound to { THE($target) }.
voodoo-user-already-bound = Something has already cursed { THE($target) }.
voodoo-user-rebind-cooldown = The doll can't curse { THE($target) } again yet.
voodoo-user-eyes-start = You peer through { THE($target) }'s eyes.
voodoo-user-eyes-end = Your sight returns to you.
voodoo-user-disguise = Chameleon
